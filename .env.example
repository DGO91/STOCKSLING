# ============================================================
#  STOCKSLING — Variables de Entorno (.env.example)
#  Copia este archivo como .env y rellena los valores reales.
# ============================================================

# --- Inteligencia Artificial ---
ANTHROPIC_API_KEY=sk-ant-api03-...       # Claude 3.5 Sonnet (Anthropic)

# --- Base de Datos (PostgreSQL async) ---
DATABASE_URL=postgresql+asyncpg://stocksling:stocksling_pass@localhost:5432/stocksling

# --- Cola de Tareas (Redis + Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Seguridad (AES-256-GCM) ---
# Genera con: python -c "from cryptography.hazmat.primitives.ciphers.aead import AESGCM; from base64 import b64encode; print(b64encode(AESGCM.generate_key(bit_length=256)).decode())"
MASTER_ENCRYPTION_KEY=your-32-byte-base64-encoded-key==

# --- JWT / Sesiones ---
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# --- Almacenamiento Cloud (AWS S3 para Presigned URLs) ---
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=stocksling-uploads
AWS_REGION=eu-west-1

# --- Agencias de Stock (cuentas de prueba para Canary Tests) ---
TEST_ADOBE_USER=your_adobe_contributor_id
TEST_ADOBE_PASS=your_adobe_ftp_password
TEST_SHUTTERSTOCK_USER=your_shutterstock_contributor_id
TEST_SHUTTERSTOCK_PASS=your_shutterstock_ftp_password

# --- Stripe (Pagos) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CASUAL=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# --- Entorno ---
ENVIRONMENT=development
